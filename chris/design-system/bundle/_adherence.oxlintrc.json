{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": [
          {
            "element": "button",
            "message": "Use <Button> from the design system instead of <button>."
          },
          {
            "element": "input",
            "message": "Use <Checkbox> from the design system instead of <input>."
          },
          {
            "element": "input",
            "message": "Use <Input> from the design system instead of <input>."
          }
        ]
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/components/Alert/**",
              "components/components/Avatar/**",
              "components/components/Badge/**",
              "components/components/Button/**",
              "components/components/Card/**",
              "components/components/Checkbox/**",
              "components/components/Graphic/**",
              "components/components/Heading/**",
              "components/components/Icon/**",
              "components/components/Input/**",
              "components/components/Logo/**",
              "components/components/Text/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Aptos))/i]",
        "message": "Font not provided by the design system. Available: Aptos."
      },
      {
        "selector": "JSXOpeningElement[name.name='Alert'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|title|className|id|style|children|key|ref|className|style|children)$/]",
        "message": "<Alert> doesn't accept that prop. Declared props: tone, title, className, id, style, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Alert'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:info|success|warning|error)$/]",
        "message": "<Alert> tone must be one of 'info' | 'success' | 'warning' | 'error'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Avatar'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|name|size|className|id|style|children|key|ref|className|style|children)$/]",
        "message": "<Avatar> doesn't accept that prop. Declared props: src, name, size, className, id, style, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|className|id|style|children|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: tone, className, id, style, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:neutral|accent|aqua|mint|lilac|coral|sand|lemon)$/]",
        "message": "<Badge> tone must be one of 'neutral' | 'accent' | 'aqua' | 'mint' | 'lilac' | 'coral' | 'sand' | 'lemon'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|iconLeft|iconRight|className|id|style|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, iconLeft, iconRight, className, id, style, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|outline|ghost)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'outline' | 'ghost'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='iconLeft'] > Literal[value!=/^(?:info|check|x|arrow-right|arrow-left|chevron-down|chevron-right|plus|minus|search|user|briefcase|star|mail|bell|calendar|alert-triangle|heart)$/]",
        "message": "<Button> iconLeft must be one of 'info' | 'check' | 'x' | 'arrow-right' | 'arrow-left' | 'chevron-down' | 'chevron-right' | 'plus' | 'minus' | 'search' | 'user' | 'briefcase' | 'star' | 'mail' | 'bell' | 'calendar' | 'alert-triangle' | 'heart'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='iconRight'] > Literal[value!=/^(?:info|check|x|arrow-right|arrow-left|chevron-down|chevron-right|plus|minus|search|user|briefcase|star|mail|bell|calendar|alert-triangle|heart)$/]",
        "message": "<Button> iconRight must be one of 'info' | 'check' | 'x' | 'arrow-right' | 'arrow-left' | 'chevron-down' | 'chevron-right' | 'plus' | 'minus' | 'search' | 'user' | 'briefcase' | 'star' | 'mail' | 'bell' | 'calendar' | 'alert-triangle' | 'heart'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|className|id|style|children|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: variant, className, id, style, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:default|elevated|feature)$/]",
        "message": "<Card> variant must be one of 'default' | 'elevated' | 'feature'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Checkbox'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|className|id|style|children|key|ref|className|style|children)$/]",
        "message": "<Checkbox> doesn't accept that prop. Declared props: label, className, id, style, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Graphic'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|width|height|alt|className|id|style|key|ref|className|style|children)$/]",
        "message": "<Graphic> doesn't accept that prop. Declared props: name, width, height, alt, className, id, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Heading'] > JSXAttribute > JSXIdentifier[name!=/^(?:level|as|className|id|style|children|key|ref|className|style|children)$/]",
        "message": "<Heading> doesn't accept that prop. Declared props: level, as, className, id, style, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Heading'] > JSXAttribute[name.name='level'] > Literal[value!=/^(?:title|subtitle|heading|bodyHeading|sectionHeader)$/]",
        "message": "<Heading> level must be one of 'title' | 'subtitle' | 'heading' | 'bodyHeading' | 'sectionHeader'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|title|className|id|style|children|ref|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, title, className, id, style, children, ref."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute[name.name='name'] > Literal[value!=/^(?:info|check|x|arrow-right|arrow-left|chevron-down|chevron-right|plus|minus|search|user|briefcase|star|mail|bell|calendar|alert-triangle|heart)$/]",
        "message": "<Icon> name must be one of 'info' | 'check' | 'x' | 'arrow-right' | 'arrow-left' | 'chevron-down' | 'chevron-right' | 'plus' | 'minus' | 'search' | 'user' | 'briefcase' | 'star' | 'mail' | 'bell' | 'calendar' | 'alert-triangle' | 'heart'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|hint|error|className|id|style|children|key|ref|className|style|children)$/]",
        "message": "<Input> doesn't accept that prop. Declared props: label, hint, error, className, id, style, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logo'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|height|className|id|style|children|key|ref|className|style|children)$/]",
        "message": "<Logo> doesn't accept that prop. Declared props: variant, height, className, id, style, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logo'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:colour|white)$/]",
        "message": "<Logo> variant must be one of 'colour' | 'white'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Text'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|as|className|id|style|children|key|ref|className|style|children)$/]",
        "message": "<Text> doesn't accept that prop. Declared props: variant, as, className, id, style, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Text'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:body|caption|muted|quote)$/]",
        "message": "<Text> variant must be one of 'body' | 'caption' | 'muted' | 'quote'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
  "x-omelette": {
    "components": {
      "Alert": {
        "replaces": []
      },
      "Avatar": {
        "replaces": []
      },
      "Badge": {
        "replaces": []
      },
      "Button": {
        "replaces": [
          "button"
        ]
      },
      "Card": {
        "replaces": []
      },
      "Checkbox": {
        "replaces": [
          "input[type=checkbox]"
        ]
      },
      "Graphic": {
        "replaces": []
